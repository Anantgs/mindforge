#!/bin/bash
set -euo pipefail
dnf install -y python3 python3-pip git nginx awscli jq
git clone '${repository}' /opt/commerce
cd /opt/commerce
python3 -m venv .venv
.venv/bin/pip install -r requirements.txt
for attempt in $(seq 1 30); do
  aws secretsmanager get-secret-value --region '${region}' --secret-id '${secret_arn}' --query SecretString --output text > /root/commerce-secret.json && break
  sleep 10
done
jq -e '.database_url and .secret_key' /root/commerce-secret.json > /dev/null
umask 077
printf 'DATABASE_URL=%s\nSECRET_KEY=%s\n' "$(jq -r .database_url /root/commerce-secret.json)" "$(jq -r .secret_key /root/commerce-secret.json)" > .env
%{ if initialize ~}
set -a
source .env
set +a
initialized=false
for attempt in $(seq 1 30); do
  if .venv/bin/flask --app app init-db; then initialized=true; break; fi
  sleep 10
done
$initialized
%{ endif ~}
printf '[Unit]\nDescription=Commerce\nAfter=network-online.target\n[Service]\nWorkingDirectory=/opt/commerce\nEnvironmentFile=/opt/commerce/.env\nExecStart=/opt/commerce/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app\nRestart=always\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/commerce.service
sed -i 's/listen       80 default_server;/listen       127.0.0.1:8081;/; s/listen       \[::\]:80 default_server;/listen       [::1]:8081;/' /etc/nginx/nginx.conf
printf 'server { listen 80 default_server; server_name _; location / { proxy_pass http://127.0.0.1:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; } }\n' > /etc/nginx/conf.d/commerce.conf
systemctl daemon-reload
systemctl enable --now commerce nginx
